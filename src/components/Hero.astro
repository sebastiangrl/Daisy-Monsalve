---
import { asset } from '../lib/asset';
---

<section class="hero" id="top" data-hero-intro>
  <img
    class="hero__photo"
    src={asset('/media/photo/hero-sesion.webp')}
    alt="Sesión de black work, de cerca, sobre la piel"
    width="1920"
    height="1080"
    fetchpriority="high"
    decoding="async"
  />
  <div class="hero__ink" data-hero-ink aria-hidden="true"></div>
  <div class="hero__shade" aria-hidden="true"></div>
  <div class="hero__copy">
    <h1>
      <span class="line" data-write="hero">Negro sólido,</span>
      <span class="line" data-write="hero">línea limpia.</span>
    </h1>
    <p data-write="hero">
      Black work ornamental e ilustrativo. Composiciones que siguen el cuerpo y se quedan en la piel con una identidad propia.
    </p>
  </div>
</section>
