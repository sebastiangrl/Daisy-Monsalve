---
import Frame from './Frame.astro';
import Ink from './Ink.astro';
import { aboutPoints, reelDown, reelUp } from '../data/site';
---

<section class="about" id="daisy">
  <div class="about__grid">
    <p class="about__display" data-write>La piel también compone.</p>
    <div class="about__facts">
      {
        aboutPoints.map((point) => (
          <article>
            <h3 data-write>{point.title}</h3>
            <p data-write>{point.text}</p>
            <Ink href={point.href} variant="text">{point.link}</Ink>
          </article>
        ))
      }
    </div>
    <div class="about__reels" aria-hidden="false">
      <div class="reel reel--down">
        <div class="reel__track">
          {reelDown.map((piece) => <Frame piece={piece} autoplay />)}
          {reelDown.map((piece) => <Frame piece={piece} autoplay />)}
        </div>
      </div>
      <div class="reel reel--up">
        <div class="reel__track">
          {reelUp.map((piece) => <Frame piece={piece} autoplay />)}
          {reelUp.map((piece) => <Frame piece={piece} autoplay />)}
        </div>
      </div>
    </div>
  </div>
</section>
