<div class="lb" data-lb hidden>
  <button class="lb__back" type="button" data-lb-close aria-label="Cerrar"></button>
  <div class="lb__panel" role="dialog" aria-modal="true" aria-label="Pieza">
    <button class="lb__x ink ink--text" type="button" data-lb-close>Cerrar</button>
    <button class="lb__nav lb__nav--prev" type="button" data-lb-prev aria-label="Anterior">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5 L8 12 L15 19" fill="none" stroke="currentColor" stroke-width="1.4" /></svg>
    </button>
    <figure class="lb__figure" data-lb-stage>
      <img data-lb-img alt="" />
      <video data-lb-video controls playsinline loop></video>
      <figcaption data-lb-cap></figcaption>
    </figure>
    <button class="lb__nav lb__nav--next" type="button" data-lb-next aria-label="Siguiente">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5 L16 12 L9 19" fill="none" stroke="currentColor" stroke-width="1.4" /></svg>
    </button>
  </div>
</div>
