<button class="book" type="button" data-open-book>
  <span class="book__flood" aria-hidden="true"></span>
  <span class="book__swirl" aria-hidden="true"></span>
  <span class="book__copy">
    <span class="book__title" data-write="enter">Agendar cita ahora</span>
    <span class="book__text" data-write="enter">Cuéntame la zona, la idea y cómo quieres que se sienta. Lo armamos con calma.</span>
  </span>
  <svg class="book__arrow" viewBox="0 0 48 48" aria-hidden="true">
    <path d="M14 34 L34 14 M18 14 H34 V30" fill="none" stroke="currentColor" stroke-width="1.6" />
  </svg>
</button>
